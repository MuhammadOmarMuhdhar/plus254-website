---
import { getCollection } from "astro:content";

const datasetCount = (await getCollection("dataset")).length;

const content = {
  title: "Quick Links",
  groups: [
    {
      label: "Discover",
      items: [
        {
          title: "Browse Datasets",
          href: "/datasets/",
          desc: `${datasetCount} ${datasetCount === 1 ? "dataset" : "datasets"} across the Kenyan economy, agriculture, and governance.`,
        },
        {
          title: "Data Sources",
          href: "/about/#how-we-source-data",
          desc: "Where the data comes from and how it is collected and updated.",
        },
        {
          title: "Our Mission",
          href: "/about/#mission",
          desc: "Why plus254 exists and what it is trying to do.",
        },
      ],
    },
    {
      label: "Developers",
      items: [
        {
          title: "API Reference",
          href: "/api-docs/",
          desc: "Full endpoint and parameter documentation with examples.",
        },
        {
          title: "Data Conventions",
          href: "/about/#conventions",
          desc: "How datasets are structured: long-form, snake_case, clean numerics, and more.",
        },
        {
          title: "Support",
          href: "/about/#support",
          desc: "Report issues, suggest datasets, or contribute on GitHub.",
        },
      ],
    },
  ],
};
---

<section class="action-groups">
  <h2 class="section-title">{content.title}</h2>

  {
    content.groups.map((group) => (
      <div class="group">
        <span class="group-label">{group.label}</span>
        <div class="action-grid action-grid--medium">
          {
            group.items.map((item) => (
              <a href={item.href} class="action-item">
                <div class="action-header">
                  <span class="action-title">{item.title}</span>
                  <svg class="action-arrow" viewBox="0 0 16 16" aria-hidden="true"><polyline points="5.5 3 11 8 5.5 13" /></svg>
                </div>
                <p class="action-desc">{item.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    ))
  }
</section>

<style>
  .action-groups {
    padding: var(--space-md) 0 var(--space-lg);
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    font-weight: var(--font-semibold);
    letter-spacing: -0.01em;
    color: var(--color-warm-dark);
    margin: 0 0 var(--space-md);
    line-height: 1.2;
  }

  .group {
    margin-bottom: var(--space-md);
  }

  .group-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-warm-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .action-grid {
    display: grid;
    gap: var(--space-smd);
  }

  .action-grid--medium {
    grid-template-columns: repeat(3, 1fr);
  }

  .action-item {
    display: block;
    position: relative;
    background-color: var(--color-green-bg);
    border: 1px solid rgba(31, 111, 84, 0.35);
    padding: var(--space-md);
    padding-right: calc(var(--space-md) + 1.25rem);
    text-decoration: none;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    transition: border-color 0.25s var(--ease-out), background-color 0.25s var(--ease-out), transform 0.2s var(--ease-out-quart), box-shadow 0.2s var(--ease-out-quart);
  }

  .action-item:hover {
    border-color: var(--color-green);
    background-color: #66b392;
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .action-item:active {
    transform: translateY(1px);
  }

  .action-item:focus-visible {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .action-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .action-title {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    flex: 1;
  }

  .action-arrow {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    color: #1f6f54;
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .action-item:hover .action-arrow {
    transform: translateX(4px);
  }

  .action-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-warm-dark);
    line-height: 1.5;
    margin: 0;
    opacity: 0.75;
  }

  @media (max-width: 768px) {
    .action-groups {
      padding: var(--space-md) 0;
    }

    .group {
      margin-bottom: var(--space-md);
    }

    .action-grid--medium {
      grid-template-columns: 1fr;
      grid-auto-rows: 1fr;
    }

    .action-item {
      padding: var(--space-md);
    }
  }
</style>
