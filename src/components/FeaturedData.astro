---
const content = {
  label: "Featured Data",
  title: "How the Iran war is affecting Kenya's tea industry",
  description:
    "Kenya's tea industry generates roughly 23% of Kenya's foreign-exchange earnings. Since the Iran–Israel conflict escalated, unsold tea at the Mombasa auction has doubled.",
  link: { label: "Explore tea data", href: "/datasets/tea/" },
  chart: {
    embedScript: "https://datawrapper.dwcdn.net/tKoO3/embed.js",
    fallbackImage: "https://datawrapper.dwcdn.net/tKoO3/full.png",
    alt: "Mombasa Tea Auction Supply and Demand Index",
  },
};
---

<section class="featured-data">
  <div class="featured-inner">
    <div class="featured-text">
      <h2 class="section-label">{content.label}</h2>
      <h3 class="featured-title">{content.title}</h3>
      <p class="featured-desc">{content.description}</p>
      <a href={content.link.href} class="featured-link">{content.link.label} <span aria-hidden="true">→</span></a>
    </div>
    <div class="featured-chart">
      <div class="chart-wrapper">
        <div class="chart-embed">
          <script type="text/javascript" defer src={content.chart.embedScript} charset="utf-8"></script>
          <noscript><img src={content.chart.fallbackImage} alt={content.chart.alt} /></noscript>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-data {
    padding: var(--space-lg) 0 var(--space-md);
  }

  .section-label {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-warm-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-smd);
  }

  .featured-inner {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .featured-text {
    flex: 1 1 30%;
    min-width: 0;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-warm-dark);
    margin: 0 0 var(--space-sm);
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
  }

  .featured-desc {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: 1.6;
    margin: 0 0 var(--space-smd);
  }

  .featured-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: #1f6f54;
    text-decoration: none;
    transition: color 0.15s var(--ease-out);
    display: inline-block;
  }

  .featured-link:hover {
    text-decoration: underline;
    color: #145c42;
  }

  .featured-link:focus-visible {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .featured-chart {
    flex: 1 1 70%;
    min-width: 0;
  }

  .chart-wrapper {
    width: 100%;
  }

  .chart-embed {
    min-height: 420px;
  }

  .chart-embed noscript img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .featured-inner {
      flex-direction: column;
      gap: var(--space-md);
    }

    .featured-data {
      padding: var(--space-md) 0;
    }

    .featured-chart {
      max-width: 100%;
      width: 100%;
      min-height: 0;
    }
  }
</style>
