---
const content = {
  label: "Featured Data",
  titleLead: "How the war in Iran affects",
  titleEmphasis: "Kenya's tea industry",
  // titleLead: "tea industry",
  description:
    "Kenya's tea industry generates roughly 23% of Kenya's foreign-exchange earnings. Since the Iran–Israel conflict escalated, unsold tea at the Mombasa auction has doubled.",
  link: { label: "Explore tea data", href: "/datasets/tea/" },
  chart: {
    embedScript: "https://datawrapper.dwcdn.net/tKoO3/embed.js",
    fallbackImage: "https://datawrapper.dwcdn.net/tKoO3/full.png",
    alt: "Mombasa Tea Auction Supply and Demand Index",
  },
};
---

<section class="featured-data">
  <div class="featured-inner">
    <div class="featured-text">
      <h2 class="section-label">{content.label}</h2>
      <h3 class="featured-title"><span class="featured-lead">{content.titleLead}</span> <span class="featured-emphasis">{content.titleEmphasis}</span></h3>
      <p class="featured-desc">{content.description}</p>
      <a href={content.link.href} class="featured-link">{content.link.label} <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><polyline points="5.5 3 11 8 5.5 13" /></svg></a>
    </div>
    <div class="featured-chart">
      <div class="chart-wrapper">
        <div class="chart-embed">
          <script type="text/javascript" defer src={content.chart.embedScript} charset="utf-8"></script>
          <noscript><img src={content.chart.fallbackImage} alt={content.chart.alt} /></noscript>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .featured-data {
    padding: var(--space-lg) 0 var(--space-md);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: var(--font-regular);
    color: var(--color-warm-light);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    display: block;
    margin-bottom: var(--space-smd);
    font-variant-numeric: tabular-nums;
  }

  .featured-inner {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .featured-text {
    flex: 1 1 30%;
    min-width: 0;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0 0 var(--space-sm);
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
  }

  .featured-lead {
    font-weight: var(--font-bold);
    letter-spacing: -0.015em;
  }

  .featured-emphasis {
    font-weight: var(--font-regular);
    /* font-style: italic; */
    color: var(--color-accent);
    letter-spacing: -0.01em;
  }

  .featured-desc {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: 1.6;
    margin: 0 0 var(--space-smd);
  }

  .featured-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-green);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-accent-muted);
    padding-bottom: 1px;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
    display: inline-block;
  }

  .featured-link:hover {
    color: var(--color-accent-strong);
    border-bottom-color: var(--color-accent);
  }

  .featured-link:focus-visible {
    outline: 2px solid var(--color-green);
    outline-offset: 2px;
  }

  .featured-chart {
    flex: 1 1 70%;
    min-width: 0;
  }

  .chart-wrapper {
    width: 100%;
  }

  .chart-embed {
    min-height: 420px;
  }

  .chart-embed noscript img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .featured-inner {
      flex-direction: column;
      gap: var(--space-md);
    }

    .featured-data {
      padding: var(--space-md) 0;
    }

    .featured-chart {
      max-width: 100%;
      width: 100%;
      min-height: 0;
    }
  }
</style>
