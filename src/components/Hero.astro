---
const content = {
  title: "Kenya's Data.",
  titleBreak: "In Machine Readable Format.",
  description:
    "Data about Kenya is buried in PDFs, scattered across messy spreadsheets, poorly documented, and hard to access. plus254 turns that mess into a reliable resource — we ingest, normalize, and serve official data through a plug-and-play API, ready to power dashboards, tools, and better decision-making.",
  ctas: [
    { label: "Explore data", href: "/datasets/", variant: "primary" },
    { label: "API docs", href: "/api-docs/", variant: "secondary" },
  ],
};
---

<section class="hero">
  <div class="hero-text">
    <!-- <div class="hero-kicker" aria-label="Seed provenance">SEED <span>42eX0B</span> · LEN 128 · SUM 259 · R×5 · SHA 5f48ae</div> -->
    <h1><span class="hero-title-bold">{content.title}</span><br /><span class="hero-title-light">{content.titleBreak}</span></h1>
    <p>{content.description}</p>
    <div class="hero-btns">
      {
        content.ctas.map((cta) => (
          <a href={cta.href} class={cta.variant === "primary" ? "btn-primary" : "btn-secondary"}>
            {cta.label} <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><polyline points="5.5 3 11 8 5.5 13" /></svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-sm) 0 var(--space-lg);
  }

  .hero-text {
    width: 100%;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: var(--font-regular);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-warm-light);
    margin-bottom: var(--space-sm);
    font-variant-numeric: tabular-nums;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
  }

  .hero-kicker span {
    color: var(--color-accent);
    font-weight: var(--font-semibold);
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: var(--space-xs);
    margin-top: 0;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: none;
  }

  .hero-title-bold {
    font-weight: var(--font-bold);
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-color: var(--color-green-muted);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
  }

  .hero-title-light {
    font-weight: var(--font-regular);
    letter-spacing: -0.015em;
    /* font-style: italic; */
    color: var(--color-warm-dark);
  }

  .hero p {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--font-regular);
    color: var(--color-warm-light);
    line-height: 1.6;
    margin-top: var(--space-xs);
    margin-bottom: var(--space-md);
    max-width: 75ch;
    text-wrap: pretty;
  }

  .hero-btns {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .hero-btns .btn-primary,
  .hero-btns .btn-secondary {
    min-width: 140px;
    padding: var(--space-sm) var(--space-md);
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
    text-align: center;
    border: 1.5px solid var(--color-green);
    transition: background-color 0.2s var(--ease-out), color 0.2s var(--ease-out), transform 0.2s var(--ease-out-quart), box-shadow 0.2s var(--ease-out-quart), border-color 0.2s var(--ease-out);
  }

  .hero-btns .btn-primary {
    background: var(--color-warm-dark);
    color: #fff;
    border-color: var(--color-warm-dark);
  }

  .hero-btns .btn-primary:hover {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: #fff;
    transform: scale(1.03);
    box-shadow: var(--shadow-sm);
  }

  .hero-btns .btn-secondary {
    background: transparent;
    color: var(--color-warm-dark);
    border-color: var(--color-warm-dark);
  }

  .hero-btns .btn-secondary:hover {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-green);
    transform: scale(1.03);
    box-shadow: var(--shadow-sm);
  }

  .hero-btns .btn-primary:active,
  .hero-btns .btn-secondary:active {
    transform: scale(0.97);
  }

  .hero-btns .btn-primary:focus-visible,
  .hero-btns .btn-secondary:focus-visible,
  .hero-btns .btn-ghost:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--color-green);
  }

  .hero-btns .btn-ghost {
    min-width: 140px;
    padding: var(--space-sm) var(--space-md);
    border-radius: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
    text-align: center;
    border: 1.5px solid transparent;
    color: var(--color-warm-light);
    transition: color 0.2s var(--ease-out);
  }

  .hero-btns .btn-ghost:hover {
    color: var(--color-warm-dark);
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-xs) 0 var(--space-lg);
    }

    .hero p {
      font-size: var(--text-sm);
    }
  }
</style>
