---
import BaseLayout from "../../layouts/BaseLayout.astro";
import APIDocsLayout from "../../components/APIDocsLayout.astro";

const content = {
  title: "Error Handling",
  sections: [
    {
      eyebrow: "HTTP Status Codes",
      paragraphs: [
        "The API uses conventional HTTP status codes to indicate success or failure.",
      ],
      table: {
        headers: ["Status", "Meaning", "What to do"],
        rows: [
          { cells: ["200 OK", "The request succeeded", "Parse the response body"] },
          { cells: ["400 Bad Request", "Invalid request parameters", "Check your query parameters for typos"] },
          { cells: ["404 Not Found", "The dataset or endpoint doesn't exist", "Verify the category and config name in the URL"] },
          { cells: ["422 Unprocessable Entity", "Request validation failed", "Fix the parameter values and retry"] },
          { cells: ["500 Internal Server Error", "Something went wrong on our end", "Wait a moment and retry; <a href=\"https://github.com/muhammadomarmuhdhar/plus254/issues\">report</a> if it persists"] },
          { cells: ["502 Bad Gateway", "Data source temporarily unavailable", "Wait and retry with exponential backoff"] },
          { cells: ["504 Gateway Timeout", "Data source took too long to respond", "Wait and retry with exponential backoff"] },
        ],
      },
    },
    {
      eyebrow: "Error Response Format",
      paragraphs: [
        "When an error occurs, the API returns a JSON body with details:",
      ],
      codeBlock: `{
  "error": {
    "code": "not_found",
    "message": "Dataset 'tea' not found for source 'unknown'",
    "link": "https://plus254.co.ke/api-docs/errors#not_found"
  }
}`,
      panels: [
        {
          title: "Error fields",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["error.code", "string", "Machine-readable error identifier"],
            ["error.message", "string", "Human-readable description of what went wrong"],
            ["error.link", "string", "URL to detailed documentation for this error code"],
          ],
        },
      ],
    },
    {
      eyebrow: "Error Codes",
      table: {
        headers: ["Code", "HTTP Status", "Meaning"],
        rows: [
          { id: "not_found", cells: ["not_found", "404", "The requested dataset or source doesn't exist"] },
          { id: "invalid_parameter", cells: ["invalid_parameter", "400, 422", "A query parameter has an invalid value"] },
          { id: "upstream_error", cells: ["upstream_error", "502, 504", "The data source could not be reached or responded with an error"] },
          { id: "internal_error", cells: ["internal_error", "500", "An unexpected error occurred on the server"] },
        ],
      },
    },
  ],
  next: { label: "Back to Quickstart", href: "/api-docs/quickstart/" },
};
---

<BaseLayout title="Error Handling — plus254 API Reference">
  <APIDocsLayout activeSection="errors">
    <header class="page-heading">
      <h1>{content.title}</h1>
    </header>

    {content.sections.map((section) => (
      <section class="section">
        <span class="eyebrow">{section.eyebrow}</span>

        {section.paragraphs && (
          <div class="narrative">
            {section.paragraphs.map((p) => <p set:html={p} />)}
          </div>
        )}

        {section.codeBlock && (
          <pre class="code-block"><code>{section.codeBlock}</code></pre>
        )}

        {section.table && (
          <table class="param-table">
            <thead>
              <tr>{section.table.headers.map((h) => <th>{h}</th>)}</tr>
            </thead>
            <tbody>
              {section.table.rows.map((row) => (
                <tr {...(row.id ? { id: row.id } : {})}>
                  {row.cells.map((cell, i) =>
                    i === 0
                      ? <td data-label={section.table.headers[i]}><code>{cell}</code></td>
                      : <td data-label={section.table.headers[i]} set:html={cell} />,
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        )}

        {section.panels && section.panels.map((panel) => (
          <div class="dataset-panel">
            <h4>{panel.title}</h4>
            <table class="dataset-table">
              <thead>
                <tr>{panel.headers.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody>
                {panel.rows.map((row) => (
                  <tr>
                    {row.map((cell, i) =>
                      i === 0
                        ? <td data-label={panel.headers[i]}><code>{cell}</code></td>
                        : <td data-label={panel.headers[i]} set:html={cell} />,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </section>
    ))}

    <a href={content.next.href} class="next-btn">
      {content.next.label}
    </a>
  </APIDocsLayout>
</BaseLayout>
