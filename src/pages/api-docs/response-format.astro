---
import BaseLayout from "../../layouts/BaseLayout.astro";
import APIDocsLayout from "../../components/APIDocsLayout.astro";

const content = {
  title: "Response Format",
  sections: [
    {
      eyebrow: "JSON Structure",
      paragraphs: [
        "Every successful endpoint returns JSON. All list and data responses include a <code>metadata.resultset</code> object describing pagination.",
      ],
      panels: [
        {
          wrapper: "common-patterns",
          title: "Shared Pagination Object",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["metadata.resultset.count", "number", "Total number of records available"],
            ["metadata.resultset.offset", "number", "Number of records skipped"],
            ["metadata.resultset.limit", "number", "Maximum records in this response"],
          ],
        },
      ],
    },
    {
      eyebrow: "List Datasets",
      signature: { method: "GET", path: "/v1/datasets" },
      panels: [
        {
          title: "Response Fields",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["metadata", "object", "Wrapper containing pagination metadata"],
            ["metadata.resultset", "object", "Pagination state (see shared object above)"],
            ["results[]", "array", "Array of dataset objects"],
            ["results[].config", "string", "Dataset config name, used in path parameters"],
            ["results[].name", "string", "Human-readable dataset title"],
            ["results[].category", "string", "Topic category (<code>economy</code>, <code>agriculture</code>, <code>governance</code>)"],
            ["results[].description", "string", "Short description of the dataset"],
            ["results[].source", "string", "Institution that publishes the data"],
            ["results[].url", "string", "Link to the original source"],
          ],
        },
      ],
    },
    {
      eyebrow: "Single Dataset",
      signature: { method: "GET", path: "/v1/datasets/{config_name}" },
      panels: [
        {
          title: "Response Fields",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["metadata", "object", "Wrapper containing pagination metadata"],
            ["metadata.resultset", "object", "Pagination state (see shared object above)"],
            ["category", "string", "Topic category (<code>economy</code>, <code>agriculture</code>, <code>governance</code>)"],
            ["source", "string", "Institution that publishes the data"],
            ["description", "string", "Short description of the dataset"],
            ["url", "string", "Link to the original source"],
            ["results[]", "array", "Array of data records. Fields correspond to the dataset's columns"],
          ],
        },
      ],
    },
    {
      eyebrow: "Dataset Info",
      signature: { method: "GET", path: "/v1/datasets/{config_name}/info" },
      panels: [
        {
          title: "Response Fields",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["config", "string", "Dataset config name"],
            ["name", "string", "Human-readable dataset title"],
            ["category", "string", "Topic category"],
            ["description", "string", "Short description of the dataset"],
            ["source", "string", "Institution that publishes the data"],
            ["url", "string", "Link to the original source"],
          ],
        },
      ],
    },
    {
      eyebrow: "Dataset Schema",
      signature: { method: "GET", path: "/v1/datasets/{config_name}/schema" },
      panels: [
        {
          title: "Response Fields",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["config", "string", "Dataset config name"],
            ["category", "string", "Topic category"],
            ["name", "string", "Human-readable dataset title"],
            ["source", "string", "Institution that publishes the data"],
            ["row_count", "number", "Total number of records in the dataset"],
            ["columns[]", "array", "Column definitions (see below)"],
          ],
        },
        {
          title: "Column Object Fields",
          headers: ["Field", "Type", "Description"],
          rows: [
            ["name", "string", "Column name"],
            ["type", "string", "Data type (<code>int64</code>, <code>float64</code>, <code>object</code>)"],
            ["description", "string", "What the column represents"],
            ["nullable", "boolean", "Whether null values are allowed"],
            ["null_count", "number", "Number of null values"],
            ["sample_values", "array", "Up to 5 example values from the column"],
            ["stats", "object|null", "Numeric summary (mean, std, min, max, quartiles) for numeric columns; <code>null</code> for non-numeric"],
          ],
        },
      ],
    },
  ],
  next: { label: "Next: Error Handling", href: "/api-docs/errors/" },
};
---

<BaseLayout title="Response Format — plus254 API Reference">
  <APIDocsLayout activeSection="response">
    <header class="page-heading">
      <h1>{content.title}</h1>
    </header>

    {content.sections.map((section) => (
      <section class="section">
        <span class="eyebrow">{section.eyebrow}</span>

        {section.paragraphs && (
          <div class="narrative">
            {section.paragraphs.map((p) => <p set:html={p} />)}
          </div>
        )}

        {section.signature && (
          <p class="endpoint-signature">
            <span class="method get">{section.signature.method}</span>
            <code>{section.signature.path}</code>
          </p>
        )}

        {section.panels.map((panel) => {
          const table = (
            <table class="dataset-table">
              <thead>
                <tr>{panel.headers.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody>
                {panel.rows.map((row) => (
                  <tr>
                    {row.map((cell, i) =>
                      i === 0
                        ? <td data-label={panel.headers[i]}><code>{cell}</code></td>
                        : <td data-label={panel.headers[i]} set:html={cell} />,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          );
          return panel.wrapper === "common-patterns" ? (
            <div class="common-patterns">
              <div class="common-patterns-header">{panel.title}</div>
              {table}
            </div>
          ) : (
            <div class="dataset-panel">
              <h4>{panel.title}</h4>
              {table}
            </div>
          );
        })}
      </section>
    ))}

    <a href={content.next.href} class="next-btn">
      {content.next.label}
    </a>
  </APIDocsLayout>
</BaseLayout>
