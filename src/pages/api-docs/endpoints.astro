---
import BaseLayout from "../../layouts/BaseLayout.astro";
import APIDocsLayout from "../../components/APIDocsLayout.astro";

const content = {
  title: "Endpoints",
  endpoints: [
    {
      eyebrow: "List Datasets",
      method: "GET",
      path: "/v1/datasets",
      description: "List all available datasets. Returns paginated metadata and an array of dataset objects. Each entry includes the dataset's <code>config</code> name &mdash; use it to fetch data or schema for a specific dataset. Use <code>category</code> to filter by topic.",
      tables: [
        {
          label: "Query parameters",
          headers: ["Parameter", "Type", "Default", "Description"],
          rows: [
            ["category", "string", "—", "Filter by topic (<code>economy</code>, <code>agriculture</code>, <code>governance</code>)"],
            ["limit", "integer", "100", "Records to return (1–100)"],
            ["offset", "integer", "0", "Records to skip"],
          ],
        },
      ],
      samples: [
        { lang: "curl", code: `curl "https://api.plus254.co.ke/v1/datasets?limit=2"` },
        {
          lang: "Python",
          code: `import requests

url = "https://api.plus254.co.ke/v1/datasets"
params = {"limit": 2}

response = requests.get(url, params=params)
print(response.json())`,
        },
        {
          lang: "JavaScript",
          code: `fetch("https://api.plus254.co.ke/v1/datasets?limit=2")
  .then(r => r.json())
  .then(data => console.log(data));`,
        },
      ],
      responseLabel: "Response",
      response: `{
  "metadata": {
    "resultset": {
      "count": 45,
      "offset": 0,
      "limit": 2
    }
  },
  "results": [
    {
      "config": "forex_period_average",
      "name": "Monthly Exchange Rates (Period Average)",
      "category": "economy",
      "description": "Monthly exchange rates of major currencies against KES",
      "source": "Central Bank of Kenya",
      "url": "https://www.centralbank.go.ke/..."
    }
  ]
}`,
    },
    {
      eyebrow: "Single Dataset",
      method: "GET",
      path: "/v1/datasets/{config_name}",
      description: "Retrieve all records for a specific dataset. Use the <code>config</code> value from the list endpoint. Unknown datasets return a <code>404</code> with a suggested correction via fuzzy matching.",
      tables: [
        {
          label: "Path parameters",
          headers: ["Parameter", "Type", "Description"],
          rows: [
            ["config_name", "string", "Dataset config, e.g. <code>forex_period_average</code>"],
          ],
        },
        {
          label: "Query parameters",
          headers: ["Parameter", "Type", "Default", "Description"],
          rows: [
            ["limit", "integer", "100", "Records to return (1–100)"],
            ["offset", "integer", "0", "Records to skip"],
          ],
        },
      ],
      samples: [
        { lang: "curl", code: `curl "https://api.plus254.co.ke/v1/datasets/forex_period_average?limit=2"` },
        {
          lang: "Python",
          code: `import requests

url = "https://api.plus254.co.ke/v1/datasets/forex_period_average"
params = {"limit": 2}

response = requests.get(url, params=params)
print(response.json())`,
        },
        {
          lang: "JavaScript",
          code: `fetch("https://api.plus254.co.ke/v1/datasets/forex_period_average?limit=2")
  .then(r => r.json())
  .then(data => console.log(data));`,
        },
      ],
      responseLabel: "Response",
      response: `{
  "metadata": {
    "resultset": {
      "count": 7980,
      "offset": 0,
      "limit": 2
    }
  },
  "source": "Central Bank of Kenya",
  "description": "Monthly exchange rates of major currencies against KES (period average)",
  "url": "https://www.centralbank.go.ke/...",
  "results": [
    {
      "year": 1993,
      "month": "january",
      "metric": "united states dollar",
      "value": 36.23
    },
    {
      "year": 1993,
      "month": "january",
      "metric": "sterling pound",
      "value": 54.48
    }
  ]
}`,
    },
    {
      eyebrow: "Dataset Info",
      method: "GET",
      path: "/v1/datasets/{config_name}/info",
      description: "Retrieve metadata for a specific dataset without loading any data rows. Returns the same shape as an entry from the list endpoint.",
      tables: [],
      samples: [
        { lang: "curl", code: `curl "https://api.plus254.co.ke/v1/datasets/forex_period_average/info"` },
        {
          lang: "Python",
          code: `import requests

url = "https://api.plus254.co.ke/v1/datasets/forex_period_average/info"

response = requests.get(url)
print(response.json())`,
        },
        {
          lang: "JavaScript",
          code: `fetch("https://api.plus254.co.ke/v1/datasets/forex_period_average/info")
  .then(r => r.json())
  .then(data => console.log(data));`,
        },
      ],
      responseLabel: "Response",
      response: `{
  "config": "forex_period_average",
  "name": "Monthly Exchange Rates (Period Average)",
  "category": "economy",
  "description": "Monthly exchange rates of major currencies against KES (period average)",
  "source": "Central Bank of Kenya",
  "url": "https://www.centralbank.go.ke/..."
}`,
    },
    {
      eyebrow: "Dataset Schema",
      method: "GET",
      path: "/v1/datasets/{config_name}/schema",
      description: "Retrieve the column schema for a dataset, including data types, null counts, summary statistics, and sample values. Useful for understanding a dataset's structure before querying it.",
      tables: [],
      samples: [
        { lang: "curl", code: `curl "https://api.plus254.co.ke/v1/datasets/forex_period_average/schema"` },
        {
          lang: "Python",
          code: `import requests

url = "https://api.plus254.co.ke/v1/datasets/forex_period_average/schema"

response = requests.get(url)
print(response.json())`,
        },
        {
          lang: "JavaScript",
          code: `fetch("https://api.plus254.co.ke/v1/datasets/forex_period_average/schema")
  .then(r => r.json())
  .then(data => console.log(data));`,
        },
      ],
      responseLabel: "Response (abbreviated)",
      response: `{
  "config": "forex_period_average",
  "category": "economy",
  "name": "Monthly Exchange Rates (Period Average)",
  "source": "Central Bank of Kenya",
  "row_count": 7980,
  "columns": [
    {
      "name": "year",
      "type": "int64",
      "description": "Calendar year",
      "nullable": false,
      "null_count": 0,
      "sample_values": [1993, 1993, 1993, 1993, 1993],
      "stats": {
        "count": 7980,
        "mean": 2009.7,
        "min": 1993,
        "max": 2026
      }
    },
    {
      "name": "value",
      "type": "float64",
      "description": "Exchange rate in KES per unit of foreign currency",
      "nullable": false,
      "null_count": 0,
      "sample_values": [36.23, 54.48, 22.67, 28.3, 6.69],
      "stats": {
        "count": 7980,
        "mean": 41.65,
        "min": 1.08,
        "max": 203.79
      }
    }
  ]
}`,
    },
  ],
  closing: [
    "All endpoints return structured error responses on failure. See <a href=\"/api-docs/errors/\">Error Handling</a> for the full error format, status codes, and what to do.",
  ],
  next: { label: "Next: Response Format", href: "/api-docs/response-format/" },
};
---

<BaseLayout title="Endpoints — +254 API Reference">
  <APIDocsLayout activeSection="endpoints">
    <header class="page-heading">
      <h1>{content.title}</h1>
    </header>

    {content.endpoints.map((endpoint) => (
      <section class="section">
        <span class="eyebrow">{endpoint.eyebrow}</span>
        <p class="endpoint-signature">
          <span class="method get">{endpoint.method}</span>
          <code>{endpoint.path}</code>
        </p>
        <div class="narrative">
          <p set:html={endpoint.description} />
        </div>

        {endpoint.tables.map((table) => (
          <>
            <p class="endpoint-label">{table.label}</p>
            <table class="param-table">
              <thead>
                <tr>{table.headers.map((h) => <th>{h}</th>)}</tr>
              </thead>
              <tbody>
                {table.rows.map((row) => (
                  <tr>
                    {row.map((cell, i) =>
                      i === 0
                        ? <td data-label={table.headers[i]}><code>{cell}</code></td>
                        : <td data-label={table.headers[i]} set:html={cell} />,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        ))}

        <p class="endpoint-label">Example request</p>
        <div class="lang-tabs" role="tablist">
          {endpoint.samples.map((sample, i) => (
            <button class:list={["lang-tab", { active: i === 0 }]} role="tab" aria-selected={i === 0 ? "true" : "false"}>{sample.lang}</button>
          ))}
        </div>

        {endpoint.samples.map((sample, i) => (
          <div class:list={["code-panel", { active: i === 0 }]}>
            <pre class="code-block"><code>{sample.code}</code></pre>
          </div>
        ))}

        <div class="response-indicator">{endpoint.responseLabel}</div>
        <pre class="code-block response-block"><code>{endpoint.response}</code></pre>
      </section>
    ))}

    <section class="section">
      <div class="narrative">
        {content.closing.map((p) => <p set:html={p} />)}
      </div>
    </section>

    <a href={content.next.href} class="next-btn">
      {content.next.label}
    </a>
  </APIDocsLayout>
</BaseLayout>

<script>
  document.querySelectorAll(".lang-tabs").forEach((tabs) => {
    const buttons = tabs.querySelectorAll(".lang-tab");
    const parent = tabs.parentElement;
    const panels = parent.querySelectorAll(".code-panel");
    buttons.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");
        if (panels[i]) panels[i].classList.add("active");
      });
    });
  });
</script>
