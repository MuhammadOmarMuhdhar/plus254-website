---
import BaseLayout from "../../layouts/BaseLayout.astro";
import APIDocsLayout from "../../components/APIDocsLayout.astro";

const content = {
  title: "Quickstart",
  intro: {
    paragraphs: [
      "All endpoints are open and require no authentication. Make a GET request to any endpoint and you'll receive a JSON response immediately. All endpoints accept <code>limit</code> and <code>offset</code> query parameters for pagination. Responses include a <code>total</code> field indicating the full number of records matching your query, so you can paginate through the complete result set.",
    ],
    url: "https://api.plus254.co.ke/v1",
  },
  firstRequest: {
    eyebrow: "Your First Request",
    lead: "Try listing the available datasets:",
    samples: [
      { lang: "curl", code: `curl "https://api.plus254.co.ke/v1/datasets?limit=2"` },
      {
        lang: "Python",
        code: `import requests

url = "https://api.plus254.co.ke/v1/datasets"
params = {"limit": 2}

response = requests.get(url, params=params)
print(response.json())`,
      },
      {
        lang: "JavaScript",
        code: `fetch("https://api.plus254.co.ke/v1/datasets?limit=2")
  .then(r => r.json())
  .then(data => console.log(data));`,
      },
    ],
    responseLabel: "Response",
    response: `{
  "metadata": {
    "resultset": {
      "count": 45,
      "offset": 0,
      "limit": 2
    }
  },
  "results": [
    {
      "config": "forex_period_average",
      "name": "Monthly Exchange Rates (Period Average)",
      "category": "economy",
      "description": "Monthly exchange rates of major currencies against KES (period average)",
      "source": "Central Bank of Kenya",
      "url": "https://www.centralbank.go.ke/..."
    },
    {
      "config": "tea",
      "name": "Tea Production and Exports",
      "category": "agriculture",
      "description": "Weekly tea auction data",
      "source": "Tea Board of Kenya",
      "url": "https://eatta.co.ke/statistics"
    }
  ]
}`,
  },
  pagination: {
    eyebrow: "Pagination",
    paragraphs: [
      "All list and data responses are paginated. Use <code>limit</code> and <code>offset</code> to control what you receive.",
    ],
    table: {
      headers: ["Parameter", "Type", "Default", "Max", "Description"],
      rows: [
        { param: "category", type: "string", default: "—", max: "—", description: "Filter by topic (<code>economy</code>, <code>agriculture</code>, <code>governance</code>)" },
        { param: "limit", type: "integer", default: "100", max: "100", description: "Maximum records to return" },
        { param: "offset", type: "integer", default: "0", max: "—", description: "Number of records to skip" },
      ],
    },
    patterns: {
      header: "Common Patterns",
      rows: [
        { label: "Filter by category", code: "GET /datasets?category=economy" },
        { label: "First page", code: "GET /datasets?limit=100&offset=0" },
        { label: "Next page", code: "GET /datasets?limit=100&offset=100" },
        { label: "Last page", code: "offset = count - (count % limit)" },
      ],
    },
  },
  next: { label: "Explore all endpoints", href: "/api-docs/endpoints/" },
};
---

<BaseLayout title="Quickstart — plus254 API Reference">
  <APIDocsLayout activeSection="quickstart-page">

    <header class="page-heading">
      <h1>{content.title}</h1>
    </header>

    <section class="section">
      <div class="narrative">
        {content.intro.paragraphs.map((p) => <p set:html={p} />)}
      </div>

      <div class="url-display">
        <span class="url-prompt">$</span>
        <span class="url-text">{content.intro.url}</span>
        <span class="url-cursor" aria-hidden="true"></span>
      </div>
    </section>

    <section class="section">
      <span class="eyebrow">{content.firstRequest.eyebrow}</span>
      <div class="narrative">
        <p>{content.firstRequest.lead}</p>
      </div>

      <div class="lang-tabs" role="tablist">
        {content.firstRequest.samples.map((sample, i) => (
          <button class:list={["lang-tab", { active: i === 0 }]} role="tab" aria-selected={i === 0 ? "true" : "false"}>{sample.lang}</button>
        ))}
      </div>

      {content.firstRequest.samples.map((sample, i) => (
        <div class:list={["code-panel", { active: i === 0 }]}>
          <pre class="code-block"><code>{sample.code}</code></pre>
        </div>
      ))}

      <div class="response-indicator">{content.firstRequest.responseLabel}</div>

      <pre class="code-block response-block"><code>{content.firstRequest.response}</code></pre>
    </section>

    <section class="section">
      <span class="eyebrow">{content.pagination.eyebrow}</span>
      <div class="narrative">
        {content.pagination.paragraphs.map((p) => <p set:html={p} />)}
      </div>

      <table class="param-table">
        <thead>
          <tr>{content.pagination.table.headers.map((h) => <th>{h}</th>)}</tr>
        </thead>
        <tbody>
          {content.pagination.table.rows.map((row) => (
            <tr>
              <td data-label="Parameter"><code>{row.param}</code></td>
              <td data-label="Type">{row.type}</td>
              <td data-label="Default">{row.default}</td>
              <td data-label="Max">{row.max}</td>
              <td data-label="Description" set:html={row.description} />
            </tr>
          ))}
        </tbody>
      </table>

      <div class="common-patterns">
        <div class="common-patterns-header">{content.pagination.patterns.header}</div>
        {content.pagination.patterns.rows.map((row) => (
          <div class="pattern-row">
            <span class="pattern-label">{row.label}</span>
            <code class="pattern-code">{row.code}</code>
          </div>
        ))}
      </div>
    </section>

    <a href={content.next.href} class="next-btn">
      {content.next.label}
    </a>
  </APIDocsLayout>
</BaseLayout>

<script>
  document.querySelectorAll(".lang-tabs").forEach((tabs) => {
    const buttons = tabs.querySelectorAll(".lang-tab");
    const parent = tabs.parentElement;
    const panels = parent.querySelectorAll(".code-panel");
    buttons.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        panels.forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");
        if (panels[i]) panels[i].classList.add("active");
      });
    });
  });
</script>
