---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutLayout from "../components/AboutLayout.astro";

const content = {
  title: "About +254",
  sections: {
    mission: {
      eyebrow: "Mission",
      paragraphs: [
        "Understanding the socioeconomic factors that shape everyday life starts with data. In Kenya, that data is scattered across PDFs and messy Excel files, inconsistently formatted, and buried in portals that are unintuitive and rarely updated. It can take hours just to locate, extract, and clean data before any analysis can begin.",
        "+254 makes data from official Kenyan sources easier to find, retrieve, and use, in formats that are ready for real work. The goal is straightforward: public data should be accessible, not just available. We hope this makes it easier for researchers, journalists, developers, and policymakers to work with the numbers that shape Kenya.",
      ],
    },
    sourcing: {
      eyebrow: "How we source data",
      paragraphs: [
        "All our data comes exclusively from official Kenyan government institutions and their public publications. Each dataset links back to its original source, so you can always trace where it came from and cite it if needed.",
        "Datasets are updated live: whenever a source publishes new data, it flows through our extraction pipeline automatically. Everything is cleaned and standardized from extraction, with no imputation of any kind. Check the <a href=\"/datasets/\">full catalog</a> for details on what's available and how each dataset is structured.",
        "Our catalog is always growing. Know a source that should be added? Open a GitHub issue with the URL and a description of what it contains.",
      ],
    },
    process: {
      eyebrow: "How we process data",
      steps: [
        {
          number: "01",
          title: "Extraction",
          description: "Raw data comes in a dozen different formats. We extract it all into a single consistent structure, so you never have to deal with the original mess.",
        },
        {
          number: "02",
          title: "Validation",
          description: "Sources contain errors, gaps, and inconsistencies. We validate every column against a defined schema to catch problems before they reach you.",
        },
        {
          number: "03",
          title: "Cleaning",
          description: "Date formats, units, column names: we standardize the presentation without touching the underlying values.",
        },
        {
          number: "04",
          title: "Publication",
          description: "Every dataset is served through the same REST API, with the same JSON format, pagination, and query patterns. Learn one, and you know them all.",
        },
      ],
    },
    conventions: {
      eyebrow: "Conventions",
      items: [
        {
          term: "Long-form data",
          description: "Every dataset uses a <code>metric</code> and <code>value</code> column pair instead of one column per indicator.",
        },
        {
          term: "snake_case columns",
          description: "All column names are snake_case: <code>fiscal_year</code>, <code>area_name</code>, <code>sale_week</code>.",
        },
        {
          term: "Lowercased values",
          description: "Every string value is lowercased: months (<code>january</code>), metric names (<code>total revenue</code>), country names (<code>united states dollar</code>), counties (<code>nairobi</code>).",
        },
        {
          term: "Clean numeric values",
          description: "Commas and other formatting are stripped. Every <code>value</code> column is numeric. Rows where a value was not reported are omitted.",
        },
        {
          term: "Schema patterns",
          description: "Monthly data has <code>year</code> and <code>month</code>, quarterly has <code>year</code> and <code>quarter</code>, annual has just <code>year</code>, and geographic datasets include <code>area_name</code>.",
        },
        {
          term: "No imputation",
          description: "Values are reported as published. Nothing is estimated, interpolated, or filled in.",
        },
      ],
    },
    support: {
      eyebrow: "Support & contributions",
      intro: "+254 is an open-source project. The code, pipelines, and dataset definitions are available on GitHub.",
      items: [
        {
          label: "Report an issue.",
          text: "If you find incorrect data, missing values, or unexpected API behavior, open a GitHub issue.",
        },
        {
          label: "Suggest a dataset.",
          text: "Know a source that should be added? Open an issue with the URL and a description of its contents.",
        },
        {
          label: "Contribute code.",
          text: "Pull requests are welcome. The codebase uses descriptive variable names and consistent pipeline patterns, making it straightforward to extend.",
        },
      ],
    },
  },
};
---

<BaseLayout title="About — plus254">
  <AboutLayout activeSection="mission">
    <header class="page-heading">
      <h1>{content.title}</h1>
    </header>

    <section class="section section--mission" id="mission">
      <span class="eyebrow">{content.sections.mission.eyebrow}</span>
      <div class="narrative">
        {content.sections.mission.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </section>

    <section class="section section--sourcing" id="how-we-source-data">
      <span class="eyebrow">{content.sections.sourcing.eyebrow}</span>
      <div class="narrative">
        {content.sections.sourcing.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </section>

    <section class="section section--process" id="data-processing-decisions">
      <span class="eyebrow">{content.sections.process.eyebrow}</span>

      <div class="process-grid">
        {content.sections.process.steps.map((step) => (
          <div class="process-step">
            <span class="step-number">{step.number}</span>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--conventions" id="conventions">
      <span class="eyebrow">{content.sections.conventions.eyebrow}</span>
      <div class="conventions-grid">
        {content.sections.conventions.items.map((item) => (
          <div class="convention-item">
            <h4 class="convention-term">{item.term}</h4>
            <p class="convention-desc" set:html={item.description} />
          </div>
        ))}
      </div>
    </section>

    <section class="section section--support" id="support">
      <span class="eyebrow">{content.sections.support.eyebrow}</span>
      <p class="section-intro">{content.sections.support.intro}</p>

      <div class="support-items">
        {content.sections.support.items.map((item) => (
          <div class="support-item">
            <span class="support-item-label">{item.label}</span>
            <span class="support-item-text">{item.text}</span>
          </div>
        ))}
      </div>
    </section>
  </AboutLayout>
</BaseLayout>

<style>
  .page-heading {
    margin-bottom: var(--space-md);
  }

  .page-heading h1 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-sm);
  }

  .section[id] {
    scroll-margin-top: 3rem;
  }

  .section + .section {
    margin-top: var(--space-fluid-xl);
  }

  .eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-warm-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-smd);
  }

  .section-intro {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 65ch;
  }

  .section-intro + .support-items {
    margin-top: var(--space-smd);
  }

  .narrative {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
  }

  .narrative p {
    margin: 0;
  }

  .narrative p + p {
    margin-top: var(--space-smd);
  }

  .narrative a {
    color: var(--color-warm-dark);
    text-decoration: underline;
    text-decoration-color: rgba(31, 111, 84, 0.4);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s var(--ease-out);
  }

  .narrative a:hover {
    text-decoration-color: #1f6f54;
  }

  .narrative a:focus-visible {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .process-step {
    background: var(--color-green-bg);
    border: 1px solid rgba(31, 111, 84, 0.35);
    padding: var(--space-md);
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    transition: border-color 0.2s var(--ease-out);
  }

  .process-step:hover {
    border-color: #1f6f54;
  }

  .step-number {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    letter-spacing: var(--tracking-wider);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-2xs);
  }

  .step-title {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    margin: 0 0 var(--space-xs);
    line-height: var(--leading-snug);
  }

  .step-desc {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-dark);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 55ch;
  }

  .conventions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md) var(--space-lg);
  }

  .convention-term {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    margin: 0 0 var(--space-2xs);
    line-height: var(--leading-snug);
  }

  .convention-desc {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 55ch;
  }

  .convention-desc code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: rgba(31, 111, 84, 0.15);
    padding: 0.125rem 0.375rem;
    color: var(--color-warm-dark);
  }

  .support-items {
    display: flex;
    flex-direction: column;
    max-width: 65ch;
  }

  .support-item {
    padding: var(--space-sm) 0;
  }

  .support-item:last-child {
    padding-bottom: 0;
  }

  .support-item-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    line-height: var(--leading-relaxed);
  }

  .support-item-text {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-2xs);
  }

  @media (max-width: 768px) {
    .page-heading {
      margin-bottom: var(--space-fluid-lg);
    }

    .process-grid {
      grid-template-columns: 1fr;
    }

    .conventions-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
