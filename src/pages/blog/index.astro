---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const content = {
  title: "Blog",
  subtitle: "Technical tutorials, how-tos, and examples for working with Kenya's open data.",
  metaDescription: "Technical tutorials, how-tos, and examples for working with Kenya's open data.",
};

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString("en-KE", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout title={`${content.title} — plus254`} description={content.metaDescription}>
  <div class="blog-index">
    <header class="page-heading">
      <h1>{content.title}</h1>
      <p class="page-subtitle">{content.subtitle}</p>
    </header>

    <div class="posts-grid">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="post-card-header">
              <span class="post-card-title">{post.data.title}</span>
              <svg class="post-card-arrow" viewBox="0 0 16 16" aria-hidden="true"><polyline points="5.5 3 11 8 5.5 13" /></svg>
            </div>
            <p class="post-card-desc">{post.data.description}</p>
            <div class="post-card-footer">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span class="post-card-type">{post.data.type}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-heading {
    margin-bottom: var(--space-fluid-xl);
  }

  .page-heading h1 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-sm);
  }

  .page-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 65ch;
  }

  .posts-grid {
    display: grid;
    gap: var(--space-smd);
    grid-template-columns: repeat(2, 1fr);
  }

  .post-card {
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--color-green-bg);
    border: 1px solid rgba(31, 111, 84, 0.35);
    padding: var(--space-md);
    padding-right: calc(var(--space-md) + 1.25rem);
    text-decoration: none;
    min-height: 10rem;
    overflow-wrap: break-word;
    word-wrap: break-word;
    hyphens: auto;
    transition: border-color 0.25s var(--ease-out), background-color 0.25s var(--ease-out), transform 0.2s var(--ease-out-quart), box-shadow 0.2s var(--ease-out-quart);
  }

  .post-card:hover {
    border-color: var(--color-green);
    background-color: #66b392;
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .post-card:active {
    transform: translateY(1px);
  }

  .post-card:focus-visible {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .post-card-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .post-card-title {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    flex: 1;
  }

  .post-card-arrow {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    color: #1f6f54;
    transition: transform 0.2s var(--ease-out);
  }

  .post-card:hover .post-card-arrow {
    transform: translateX(4px);
  }

  .post-card-desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-warm-dark);
    line-height: 1.5;
    margin: 0;
    opacity: 0.75;
    flex: 1;
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(31, 111, 84, 0.2);
  }

  .post-card-footer time {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-warm-dark);
    opacity: 0.7;
  }

  .post-card-type {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: #1f6f54;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(31, 111, 84, 0.12);
    padding: var(--space-2xs) var(--space-xs);
  }

  @media (max-width: 768px) {
    .page-heading h1 {
      font-size: var(--text-xl);
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .post-card {
      padding: var(--space-md);
      min-height: auto;
    }
  }
</style>
