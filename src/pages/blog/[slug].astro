---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { entry: post },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-KE", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const tocHeadings = headings.filter((h) => h.depth <= 3);
const hasToc = entry.data.toc === true;
---

<BaseLayout title={`${entry.data.title} — plus254`} description={entry.data.description}>
  {
    hasToc ? (
      <div class="post-layout post-layout--analysis">
        <aside class="toc-sidebar">
          <nav class="toc-nav" aria-label="Table of contents">
            <span class="toc-label">Contents</span>
            {tocHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class:list={["toc-link", `toc-link--depth-${h.depth}`]}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </aside>
        <main class="post-main">
          <header class="post-header">
            <a href="/blog/" class="post-back"><svg class="post-back-arrow" viewBox="0 0 16 16" aria-hidden="true"><polyline points="10.5 3 5 8 10.5 13" /></svg></a>
            <h1>{entry.data.title}</h1>
            <div class="post-meta">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <span class="post-type">{entry.data.type}</span>
              {entry.data.tags && entry.data.tags.length > 0 && (
                <span class="post-tags">
                  {entry.data.tags.map((tag) => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </span>
              )}
            </div>
          </header>
          <div class="post-body post-body--wide">
            <Content />
          </div>
        </main>
      </div>
    ) : (
      <div class="post-layout post-layout--tutorial">
        <header class="post-header">
          <a href="/blog/" class="post-back"><svg class="post-back-arrow" viewBox="0 0 16 16" aria-hidden="true"><polyline points="10.5 3 5 8 10.5 13" /></svg></a>
          <h1>{entry.data.title}</h1>
          <div class="post-meta">
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
            <span class="post-type">{entry.data.type}</span>
            {entry.data.tags && entry.data.tags.length > 0 && (
              <span class="post-tags">
                {entry.data.tags.map((tag) => (
                  <span class="post-tag">{tag}</span>
                ))}
              </span>
            )}
          </div>
        </header>
        <div class="post-body">
          <Content />
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  /* ===== Shared post styles ===== */

  .post-back {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-warm-light);
    text-decoration: none;
    gap: var(--space-2xs);
    margin-bottom: var(--space-sm);
    transition: color 0.15s var(--ease-out);
  }

  .post-back-arrow {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .post-back:hover {
    color: #1f6f54;
  }

  .post-back:focus-visible {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .post-header {
    margin-bottom: var(--space-lg);
  }

  .post-header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--space-sm);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .post-meta time {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-warm-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-type {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: #1f6f54;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(31, 111, 84, 0.1);
    padding: var(--space-2xs) var(--space-xs);
  }

  .post-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .post-tag {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-warm-light);
    border: 1px solid rgba(31, 111, 84, 0.35);
    padding: var(--space-2xs) var(--space-xs);
    line-height: var(--leading-normal);
  }

  /* ===== Tutorial layout ===== */
  .post-layout--tutorial {
    max-width: 65ch;
    margin: 0 auto;
  }

  .post-layout--tutorial .post-body {
    max-width: 65ch;
  }

  /* ===== Analysis layout ===== */
  .post-layout--analysis {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .toc-sidebar {
    width: 185px;
    flex-shrink: 0;
    position: sticky;
    top: var(--space-lg);
    padding-top: var(--space-sm);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .toc-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    color: var(--color-warm-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
  }

  .toc-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-warm-light);
    text-decoration: none;
    padding: var(--space-2xs) var(--space-sm);
    border-left: 2px solid transparent;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
    line-height: var(--leading-snug);
  }

  .toc-link:hover {
    color: var(--color-warm-dark);
    border-left-color: rgba(31, 111, 84, 0.3);
  }

  .toc-link:focus-visible {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .toc-link--depth-3 {
    padding-left: var(--space-md);
  }

  .post-main {
    flex: 1;
    min-width: 0;
    max-width: 100%;
  }

  .post-body--wide {
    max-width: 100%;
  }

  /* ===== Post body typography ===== */
  .post-body {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-warm-mid);
    line-height: var(--leading-relaxed);
  }

  .post-body :global(p) {
    margin: 0 0 var(--space-smd);
  }

  .post-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .post-body :global(h2) {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    margin: var(--space-lg) 0 var(--space-sm);
  }

  .post-body :global(h3) {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-warm-dark);
    line-height: var(--leading-snug);
    margin: var(--space-md) 0 var(--space-sm);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 var(--space-smd);
    padding-left: var(--space-md);
  }

  .post-body :global(li) {
    margin-bottom: var(--space-xs);
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(31, 111, 84, 0.15);
    padding: 0.0625rem 0.25rem;
    color: var(--color-warm-dark);
  }

  .post-body :global(pre) {
    background: var(--color-green-bg) !important;
    border: 1px solid rgba(31, 111, 84, 0.35) !important;
    padding: var(--space-md) !important;
    overflow-x: auto;
    overflow-y: hidden;
    margin: 0 0 var(--space-md) !important;
    font-size: var(--text-sm) !important;
    line-height: var(--leading-normal);
    tab-size: 2;
    max-width: 100%;
    word-wrap: normal;
    white-space: pre;
  }

  .post-body :global(pre code) {
    background: transparent !important;
    padding: 0 !important;
    font-size: inherit;
    color: var(--color-warm-dark) !important;
  }

  .post-body :global(a) {
    color: var(--color-warm-dark);
    text-decoration: underline;
    text-decoration-color: rgba(31, 111, 84, 0.4);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s var(--ease-out);
  }

  .post-body :global(a:hover) {
    text-decoration-color: #1f6f54;
  }

  .post-body :global(a:focus-visible) {
    outline: 2px solid #1f6f54;
    outline-offset: 2px;
  }

  .post-body :global(blockquote) {
    border-left: 2px solid #1f6f54;
    margin: var(--space-md) 0;
    padding-left: var(--space-md);
    color: var(--color-warm-dark);
    font-style: italic;
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .post-layout--analysis {
      flex-direction: column;
      gap: var(--space-lg);
    }

    .toc-sidebar {
      position: static;
      width: 100%;
      max-height: none;
      overflow-y: visible;
      padding-top: 0;
    }

    .toc-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-xs);
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid rgba(31, 111, 84, 0.15);
    }

    .toc-label {
      width: 100%;
      padding: var(--space-xs) 0;
      margin-bottom: 0;
    }

    .toc-link {
      border-left: none;
      border-bottom: 2px solid transparent;
      padding: var(--space-xs) var(--space-sm);
      white-space: nowrap;
    }

    .toc-link:hover {
      border-left-color: transparent;
      border-bottom-color: rgba(31, 111, 84, 0.3);
    }

    .toc-link--depth-3 {
      padding-left: var(--space-sm);
    }
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: var(--text-xl);
    }

    .post-layout--tutorial {
      max-width: 100%;
    }
  }
</style>
