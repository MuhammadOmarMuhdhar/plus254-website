---
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";

export interface Props {
  title?: string;
  description?: string;
}

const { title = "plus254", description = "Kenya's data. Available and machine-readable." } = Astro.props;
const siteTitle = title.startsWith("+254") || title.includes("—") ? title : `${title} — +254`;
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f6f54" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://datawrapper.dwcdn.net" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,100..1000&family=Newsreader:opsz,wght@6..72,200..800&display=swap"
      as="style"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,100..1000&family=Newsreader:opsz,wght@6..72,200..800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden-focusable">Skip to main content</a>
    <Header />
    <main id="main-content" class="page" data-pagefind-body>
      <slot />
    </main>
    <Footer />

    <PagefindConfig instance="site-search" />
    <pagefind-modal instance="site-search">
      <pagefind-modal-header>
        <pagefind-input></pagefind-input>
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary></pagefind-summary>
        <pagefind-results hide-sub-results></pagefind-results>
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints></pagefind-keyboard-hints>
      </pagefind-modal-footer>
    </pagefind-modal>
  </body>
</html>

<style>
  .visually-hidden-focusable {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .visually-hidden-focusable:focus-within {
    position: fixed;
    top: 0;
    left: 0;
    width: auto;
    height: auto;
    padding: var(--space-sm) var(--space-md);
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
    z-index: 1000;
    background: #1f6f54;
    color: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-decoration: none;
    outline: none;
  }

  .page {
    max-width: 960px;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
    min-height: calc(100vh - 200px);
  }
</style>

<style is:global>
  /* Pagefind Component UI theming to match +254 brand */
  :root {
    --pf-text: #2c241c;
    --pf-text-secondary: #6b5d4f;
    --pf-text-muted: #8a7d6f;
    --pf-background: #ffffff;
    --pf-border: rgba(108, 185, 153, 0.5);
    --pf-border-focus: #1f6f54;
    --pf-hover: #e8f3ee;
    --pf-mark: #1f6f54;
    --pf-outline-focus: #1f6f54;
    --pf-font: "DM Sans", system-ui, sans-serif;
    --pf-modal-backdrop: rgba(44, 36, 28, 0.4);
    --pf-border-radius: 0;
  }

  /* Force sharp edges on Pagefind modal (overrides hardcoded 12px radius) */
  dialog.pf-modal {
    border-radius: 0 !important;
  }

  /* Sharp edges on result cards and other rounded Pagefind elements */
  .pf-result-card,
  .pf-heading-chip,
  .pf-searchbox-result,
  .pf-dropdown-menu,
  .pf-filter-pane {
    border-radius: 0 !important;
  }

  .pf-result-link {
    color: #1f6f54;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pf-result-link:hover {
    text-decoration: none;
  }

  .pf-result-title {
    font-weight: 600;
  }
</style>
